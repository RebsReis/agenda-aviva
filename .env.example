# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# (ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, nome criado pela integração da Vercel)

# Endereço público do app (usado nos links de confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
